export interface ParsedFilter {
  isAiParsed: boolean;
  explanation: string | null;
  targetLevel?: number; // 0 - дивизион, 1 - отдел, 2 - команда
  minPerformance?: number;
  maxPerformance?: number;
  minBudget?: number;
  maxBudget?: number;
